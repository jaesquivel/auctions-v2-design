# Proposed deployment-time profile, not an application administrator setting.
# One instance and database per country. No request or UI may override these values.
INSTANCE_COUNTRY=CR
INSTANCE_TIMEZONE=America/Costa_Rica
INSTANCE_ADAPTER=cr-judicial-v1
INSTANCE_DEFAULT_LOCALE=es-CR
INSTANCE_SUPPORTED_UI_LANGUAGES=es,en
# Currency is source data; this profile does not prohibit USD or other explicit currencies.
# Startup must verify a matching singleton jurisdiction row and adapter.
