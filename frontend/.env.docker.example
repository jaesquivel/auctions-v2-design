# Copy to .env.docker; keep private values out of Git and build arguments.
AUCTIONS_IMAGE=auctions-prototype:latest
# Local loopback port for the prototype.
HTTP_PORT=8080
# Public variables: image must be rebuilt when these change.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
# Runtime secret only; leave empty for the fictional demo.
CLERK_SECRET_KEY=
